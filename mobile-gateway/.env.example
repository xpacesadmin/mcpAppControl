# Placeholders only. Do not commit live addresses, tokens, keys, or paths.
MOBILE_GATEWAY_BIND_HOST=<APPROVED_VPN_INTERFACE_IP>
MOBILE_GATEWAY_PORT=8743
MOBILE_GATEWAY_VPN_CIDRS=100.64.0.0/10,fd7a:115c:a1e0::/48
MOBILE_GATEWAY_TLS_CERT_FILE=<ABSOLUTE_PATH_TO_TLS_CERTIFICATE>
MOBILE_GATEWAY_TLS_KEY_FILE=<ABSOLUTE_PATH_TO_TLS_PRIVATE_KEY>
MOBILE_GATEWAY_DB_FILE=<ABSOLUTE_PATH_TO_GATEWAY_SQLITE_DATABASE>

# This file remains on the Lab VM and contains only the desktop loopback API token.
MOBILE_GATEWAY_DESKTOP_TOKEN_FILE=<ABSOLUTE_PATH_TO_DESKTOP_TOKEN_FILE>
MOBILE_GATEWAY_DESKTOP_BASE_URL=http://127.0.0.1:8733/api/v1

# Safe default. Enabling writes requires a separate owner-approved deployment step.
MOBILE_GATEWAY_WRITES_ENABLED=0
MOBILE_GATEWAY_ALLOWED_ACTIONS=
MOBILE_GATEWAY_ALLOWED_PACKAGES=

MOBILE_GATEWAY_ACCESS_TTL_SECONDS=300
MOBILE_GATEWAY_REFRESH_TTL_SECONDS=2592000
MOBILE_GATEWAY_MAX_CLOCK_SKEW_SECONDS=120
MOBILE_GATEWAY_UPSTREAM_TIMEOUT_MS=5000

# Must remain disabled. The gateway also rejects upstream state that reports Hermes on.
MCP_HERMES_ENABLED=0

